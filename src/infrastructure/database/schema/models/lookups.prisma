model Gender {
  code  String @id @db.VarChar(30)
  users User[]

  @@map("genders")
}

model TravelType {
  code  String @id @db.VarChar(20)
  users User[]

  @@map("travel_types")
}

model TravelPersonality {
  code  String @id @db.VarChar(20)
  users User[]

  @@map("travel_personalities")
}

model MatchPreference {
  code  String @id @db.VarChar(20)
  users User[]

  @@map("match_preferences")
}

model AccountStatus {
  code   String  @id @db.VarChar(20)
  users  User[]
  admins Admin[]

  @@map("account_statuses")
}

model OnlineStatus {
  code          String         @id @db.VarChar(20)
  userLocations UserLocation[]

  @@map("online_statuses")
}

model ProfileVisibility {
  code          String        @id @db.VarChar(30)
  userPrivacies UserPrivacy[]

  @@map("profile_visibilities")
}

model RequestFromOption {
  code          String        @id @db.VarChar(30)
  userPrivacies UserPrivacy[]

  @@map("request_from_options")
}

model OnboardingSource {
  code            String           @id @db.VarChar(50)
  userOnboardings UserOnboarding[]

  @@map("onboarding_sources")
}

model TripStatus {
  code  String @id @db.VarChar(20)
  label String @db.VarChar(50)

  trips Trip[]

  @@map("trip_statuses")
}

model TripMemberRole {
  code  String @id @db.VarChar(20)
  label String @db.VarChar(50)

  members TripGroupMember[]

  @@map("trip_member_roles")
}

model TripInviteStatus {
  code  String @id @db.VarChar(20)
  label String @db.VarChar(50)

  invites TripGroupInvite[]

  @@map("trip_invite_statuses")
}

model TripStyle {
  code  String @id @db.VarChar(20)
  label String @db.VarChar(50)

  trips Trip[]

  @@map("trip_style")
}

model BudgetStyle {
  code  String @id @db.VarChar(20)
  label String @db.VarChar(50)

  trips Trip[]

  @@map("budget_style")
}

model ChecklistCategory {
  code         String @id
  name         String
  displayOrder Int    @map("display_order")

  items ChecklistItem[]

  @@map("checklist_category")
}

model ChecklistPriority {
  code String @id
  name String

  items ChecklistItem[]

  @@map("checklist_priority")
}

model ChecklistActivityType {
  code String @id
  name String

  logs ChecklistActivity[]

  @@map("checklist_activity_type")
}
