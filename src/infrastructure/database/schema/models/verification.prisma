model Verification {
    id     String @id @default(uuid()) @db.Uuid
    userId String @map("user_id") @db.Uuid

    documentTypeCode   String  @map("document_type_code") @db.VarChar(30)
    statusCode         String  @default("processing") @map("status_code") @db.VarChar(30)
    assignedReviewerId String? @map("assigned_reviewer_id") @db.Uuid

    submittedAt     DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
    reviewStartedAt DateTime? @map("review_started_at") @db.Timestamptz(6)
    reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)

    reviewNotes        String?  @map("review_notes")
    rejectionReason    String?  @map("rejection_reason")
    resubmissionReason String?  @map("resubmission_reason")
    overallRiskScore   Decimal? @map("overall_risk_score") @db.Decimal(5, 2)
    ocrConfidence      Decimal? @map("ocr_confidence") @db.Decimal(5, 2)

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    user         User                     @relation(fields: [userId], references: [id])
    reviewer     Admin?                   @relation("VerificationReviewer", fields: [assignedReviewerId], references: [id])
    documentType VerificationDocumentType @relation(fields: [documentTypeCode], references: [code])
    status       VerificationStatus       @relation(fields: [statusCode], references: [code])

    documents     VerificationDocument[]
    extractedData VerificationExtractedData?
    activities    VerificationActivity[]

    @@index([userId])
    @@index([statusCode])
    @@index([assignedReviewerId])
    @@map("verifications")
}

model VerificationDocument {
    id             String @id @default(uuid()) @db.Uuid
    verificationId String @map("verification_id") @db.Uuid

    sideCode String @map("side_code") @db.VarChar(20)

    storageKey  String @map("file_url") @db.VarChar(500)
    mimeType String @map("mime_type") @db.VarChar(100)
    fileSize Int    @map("file_size")
    width    Int?
    height   Int?

    uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

    verification Verification             @relation(fields: [verificationId], references: [id])
    side         VerificationDocumentSide @relation(fields: [sideCode], references: [code])

    @@index([verificationId])
    @@map("verification_documents")
}

model VerificationExtractedData {
    id String @id @default(uuid()) @db.Uuid

    verificationId String @unique @map("verification_id") @db.Uuid

    fullName       String?   @map("full_name") @db.VarChar(255)
    documentNumber String?   @map("document_number") @db.VarChar(100)
    nationality    String?   @db.VarChar(100)
    gender         String?   @db.VarChar(30)
    dateOfBirth    DateTime? @map("date_of_birth") @db.Date

    expiryDate       DateTime? @map("expiry_date") @db.Date
    issuingCountry   String?   @map("issuing_country") @db.VarChar(100)
    issuingAuthority String?   @map("issuing_authority") @db.VarChar(150)
    documentVersion  String?   @map("document_version") @db.VarChar(50)

    rawResponse Json? @map("raw_response")
    analysisSummary Json? @map("analysis_summary")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

    @@map("verification_extracted_data")
}

model VerificationActivity {
    id                 String  @id @default(uuid()) @db.Uuid
    verificationId     String  @map("verification_id") @db.Uuid
    actionCode         String  @map("action_code") @db.VarChar(40)
    performedByAdminId String? @map("performed_by_admin_id") @db.Uuid

    notes    String?
    metadata Json?

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    verification Verification             @relation(fields: [verificationId], references: [id])
    admin        Admin?                   @relation(fields: [performedByAdminId], references: [id])
    action       VerificationActivityType @relation(fields: [actionCode], references: [code])

    @@index([verificationId])
    @@map("verification_activities")
}
