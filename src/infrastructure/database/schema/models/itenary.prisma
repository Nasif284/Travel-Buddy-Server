model ItineraryDay {
    id String @id @default(uuid()) @db.Uuid

    groupId String @map("group_id") @db.Uuid
    group TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    date DateTime @db.Date
    location String? @db.VarChar(255)
    latitude Decimal? @db.Decimal(10,7)
    longitude Decimal? @db.Decimal(10,7)
    summary String?

    createdBy String @map("created_by") @db.Uuid
    creator TripGroupMember @relation(fields: [createdBy], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    activities ItineraryActivity[]

    @@index([groupId])
    @@unique([groupId, date])
    @@map("itinerary_days")
}

model ItineraryActivity {
    id String @id @default(uuid()) @db.Uuid

    dayId String @map("day_id") @db.Uuid
    day ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

    title String
    description String?
    
    location String
    latitude Decimal? @db.Decimal(10,7)
    longitude Decimal? @db.Decimal(10,7)

    categoryCode String @map("category_code")
    category ActivityCategory @relation(fields: [categoryCode], references: [code])

    startTime String @db.VarChar(10)
    durationMinutes Int

    notes String?

    sortOrder Int @default(0)
    isCompleted Boolean @default(false)

    createdBy String @map("created_by") @db.Uuid
    creator TripGroupMember @relation(fields: [createdBy], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([dayId])
    @@map("itinerary_activities")
}

model ActivityCategory {
    code String @id
    name String

    activities ItineraryActivity[]

    @@map("activity_categories")
}