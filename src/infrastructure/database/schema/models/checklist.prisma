model ChecklistItem {
  id String @id @default(uuid()) @db.Uuid

  groupId String  @db.Uuid
  group TripGroup @relation(fields: [groupId], references: [id])

  categoryCode String  @map("category_code") @db.VarChar(100)
  category ChecklistCategory @relation(fields: [categoryCode], references: [code])

  title String 
  notes String?

  priorityCode String @map("priority_code")
  priority ChecklistPriority @relation(fields: [priorityCode], references: [code])

  isCompleted Boolean @default(false) @map("is_completed")

  assignedTo String? @map("assigned_to")  @db.Uuid
  assignee TripGroupMember? @relation( "ChecklistAssignedMember", fields: [assignedTo], references: [id])

  createdBy String @map("assigned_by")  @db.Uuid
  creator User @relation( "ChecklistCreator", fields: [createdBy], references: [id])

  completedAt DateTime?  @map("completed_at")
  createdAt DateTime @default(now())  @map("created_at")
  updatedAt DateTime @updatedAt  @map("updated_at")

  activities ChecklistActivity[]

  @@index([groupId])
  @@index([categoryCode])
  @@index([assignedTo])

  @@map("checklist_items")
}

model ChecklistActivity {
  id String @id @default(uuid()) @db.Uuid

  itemId String @map("item_id")  @db.Uuid
  item ChecklistItem @relation(fields: [itemId], references: [id])

  userId String @map("user_id")  @db.Uuid
  user User @relation(fields: [userId], references: [id])

  actionCode String @map("action_code")
  action ChecklistActivityType @relation(fields: [actionCode], references: [code])

  message String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId])
    @@map("checklist_activity")
}