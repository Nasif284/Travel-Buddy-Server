model ExpenseCategory {
  code String @id @db.VarChar(100)
  name String @unique @db.VarChar(100)
  displayOrder Int @default(0) @map("display_order")

  expenses Expense[]

  @@map("expense_categories")
}

model ExpenseSplitMethod {
  code String @id @db.VarChar(30)
  name String @unique @db.VarChar(50)
  expenses Expense[]

  @@map("expense_split_methods")
}

model Expense {
  id String @id @default(uuid()) @db.Uuid

  groupId String @map("group_id") @db.Uuid
  group TripGroup @relation(fields: [groupId], references: [id])

  title String @db.VarChar(200)
  description String?
  amount Decimal @db.Decimal(12,2)
  expenseDate DateTime @map("expense_date") @db.Date

  categoryCode String @map("category_code") @db.VarChar(100)
  category ExpenseCategory @relation(fields: [categoryCode], references: [code])

  splitMethodCode String @map("split_method_code") @db.VarChar(30)
  splitMethod ExpenseSplitMethod @relation(fields: [splitMethodCode], references: [code])

  paidById String @map("paid_by_id") @db.Uuid
  paidBy TripGroupMember @relation( "ExpensePaidBy", fields: [paidById], references: [id])

  createdBy String @map("created_by") @db.Uuid
  creator User @relation( "ExpenseCreator", fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shares ExpenseShare[]
  activities ExpenseActivity[]

  @@index([groupId])
  @@index([categoryCode])
  @@index([paidById])
  @@index([expenseDate])

  @@map("expenses")
}

model ExpenseShare {
  id String @id @default(uuid()) @db.Uuid

  expenseId String @map("expense_id") @db.Uuid
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  memberId String @map("member_id") @db.Uuid
  member TripGroupMember @relation( fields: [memberId], references: [id])

  amount Decimal @db.Decimal(12,2)
  percentage Decimal? @db.Decimal(5,2)
  shares Decimal? @db.Decimal(10,2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([expenseId, memberId])
  @@index([memberId])
  @@map("expense_shares")
}

model ExpenseActivity {
  id String @id @default(uuid()) @db.Uuid
  expenseId String @map("expense_id") @db.Uuid
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id])

  actionCode String @map("action_code")
  action ExpenseActivityType @relation(fields: [actionCode], references: [code])

  message String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expenseId])

  @@map("expense_activities")
}
model ExpenseActivityType {
  code String @id @db.VarChar(50)
  name String @unique @db.VarChar(100)

  activities ExpenseActivity[]

  @@map("expense_activity_types")
}

model ExpenseSettlement {
  id String @id @default(uuid()) @db.Uuid

  groupId String @map("group_id") @db.Uuid
  group TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  payerMemberId String @map("payer_member_id") @db.Uuid
  payer TripGroupMember @relation( "SettlementPayer", fields: [payerMemberId], references: [id])

  receiverMemberId String @map("receiver_member_id") @db.Uuid
  receiver TripGroupMember @relation( "SettlementReceiver", fields: [receiverMemberId], references: [id])

  amount Decimal @db.Decimal(12,2)
  note String?
  settledAt DateTime @default(now()) @map("settled_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([payerMemberId])
  @@index([receiverMemberId])

  @@map("expense_settlements")
}