model User {
  id       String  @id @default(uuid()) @db.Uuid
  fullName String  @map("full_name") @db.VarChar(100)
  email    String  @unique @db.VarChar(255)
  phone    String? @unique @db.VarChar(20)

  passwordHash String? @map("password_hash") @db.VarChar(255)

  avatarUrl   String?   @map("avatar_url") @db.VarChar(500)
  coverUrl    String?   @map("cover_url") @db.VarChar(500)
  bio         String?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isIdVerified    Boolean   @default(false) @map("is_id_verified")
  isTraveling     Boolean   @default(false) @map("is_traveling")
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  idVerifiedAt    DateTime? @map("id_verified_at") @db.Timestamptz(6)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  genderCode            String? @map("gender_code") @db.VarChar(30)
  travelTypeCode        String? @map("travel_type_code") @db.VarChar(20)
  travelPersonalityCode String? @map("travel_personality_code") @db.VarChar(20)
  matchWithCode         String? @default("everyone") @map("match_with_code") @db.VarChar(20)
  accountStatusCode     String  @default("active") @map("account_status_code") @db.VarChar(20)

  countryCode String? @map("country_code") @db.VarChar(10)
  state       String? @map("origin_region") @db.VarChar(100)
  city        String? @map("origin_city") @db.VarChar(100)

  gender            Gender?            @relation(fields: [genderCode], references: [code])
  travelType        TravelType?        @relation(fields: [travelTypeCode], references: [code])
  travelPersonality TravelPersonality? @relation(fields: [travelPersonalityCode], references: [code])
  matchPreference   MatchPreference?   @relation(fields: [matchWithCode], references: [code])
  accountStatus     AccountStatus      @relation(fields: [accountStatusCode], references: [code])
  country           Country?           @relation(fields: [countryCode], references: [code])

  createdTrips     Trip[]              @relation("TripCreator")
  sentRequests     ConnectionRequest[] @relation("ConnectionSender")
  receivedRequests ConnectionRequest[] @relation("ConnectionReceiver")

  location                 UserLocation?
  onboarding               UserOnboarding?
  privacy                  UserPrivacy?
  languages                UserLanguage[]
  interests                UserInterest[]
  skills                   UserSkill[]
  statusHistory            UserStatusHistory[]
  verifications            Verification[]
  userAConnections         Connection[]            @relation("ConnectionUserA")
  userBConnections         Connection[]            @relation("ConnectionUserB")
  tripGroupsOwned          TripGroup[]             @relation("TripGroupOwner")
  createdTasks             ChecklistItem[]         @relation("ChecklistCreator")
  groupMemberships         TripGroupMember[]
  createdExpenses          Expense[]               @relation("ExpenseCreator")
  expenseActivities        ExpenseActivity[]
  groupInvitesSent         TripGroupInvite[]       @relation("TripGroupInviter")
  checklistActivities      ChecklistActivity[]
  aiConversations          AssistantConversation[]
  chatConversationsAsUserA ChatConversation[]      @relation("ChatUserA")
  chatConversationsAsUserB ChatConversation[]      @relation("ChatUserB")
  chatMessages             ChatMessage[]
  initiatedCalls           Call[]                  @relation("CallCaller")
  receivedCalls            Call[]                  @relation("CallRecipient")
  callParticipants         CallParticipant[]

  @@index([email])
  @@index([phone])
  @@index([accountStatusCode])
  @@index([isPhoneVerified])
  @@index([isIdVerified])
  @@index([deletedAt])
  @@map("users")
}

model UserLocation {
  userId       String                                @id @map("user_id") @db.Uuid
  lastSeenAt   DateTime?                             @map("last_seen_at") @db.Timestamptz(6)
  currentLat   Decimal?                              @map("current_lat") @db.Decimal(10, 8)
  currentLng   Decimal?                              @map("current_lng") @db.Decimal(11, 8)
  currentCity  String?                               @map("current_city") @db.VarChar(100)
  currentState String?                               @map("current_state") @db.VarChar(100)
  coordinates  Unsupported("geography(Point,4326)")?
  updatedAt    DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)

  onlineStatusCode String       @default("offline") @map("online_status_code") @db.VarChar(20)
  onlineStatus     OnlineStatus @relation(fields: [onlineStatusCode], references: [code])

  currentCountryCode String?  @map("current_country_code") @db.VarChar(10)
  currentCountry     Country? @relation(fields: [currentCountryCode], references: [code])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onlineStatusCode])
  @@index([currentLat, currentLng])
  @@map("user_locations")
}

model UserOnboarding {
  userId              String    @id @map("user_id") @db.Uuid
  onboardingStep      Int       @default(1) @map("onboarding_step") @db.SmallInt
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  onboardingSourceCode String?           @map("onboarding_source_code") @db.VarChar(50)
  onboardingSource     OnboardingSource? @relation(fields: [onboardingSourceCode], references: [code])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_onboarding")
}

model UserPrivacy {
  userId              String   @id @map("user_id") @db.Uuid
  showOnlineStatus    Boolean  @default(true) @map("show_online_status")
  showTravelingStatus Boolean  @default(false) @map("show_traveling_status")
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  profileVisibilityCode String?            @default("everyone") @map("profile_visibility_code") @db.VarChar(30)
  profileVisibility     ProfileVisibility? @relation(fields: [profileVisibilityCode], references: [code])

  requestsFromCode String?            @default("everyone") @map("requests_from_code") @db.VarChar(30)
  requestsFrom     RequestFromOption? @relation(fields: [requestsFromCode], references: [code])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_privacy_settings")
}

model UserStatusHistory {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  statusCode     String    @map("status_code") @db.VarChar(20)
  reason         String?
  durationDays   Int?      @map("duration_days")
  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz(6)
  actionedBy     String?   @map("actioned_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([effectiveFrom])
  @@map("user_status_history")
}

model UserLanguage {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  language String @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
  @@index([userId])
  @@map("user_languages")
}

model UserSkill {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  skill  String @db.VarChar(100)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId])
  @@map("user_travel_skills")
}

model UserInterest {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  interest String @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, interest])
  @@index([userId])
  @@map("user_interests")
}

model ConnectionRequest {
  id String @id @default(uuid()) @db.Uuid

  senderId   String @db.Uuid
  receiverId String @db.Uuid

  matchId String

  message String?

  statusCode String @default("pending")

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  sender User @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiver User      @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  match    TripMatch @relation(fields: [matchId], references: [id])

  status ConnectionStatus @relation(fields: [statusCode], references: [code])

  connections Connection[]

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@map("connection_requests")
}

model ConnectionStatus {
  code String @id

  requests ConnectionRequest[]

  @@map("connection_status")
}

model Connection {
  id String @id @default(uuid()) @db.Uuid

  userAId   String  @db.Uuid
  userBId   String  @db.Uuid
  isActive  Boolean @default(true)
  requestId String  @unique @db.Uuid

  connectedAt DateTime @default(now())

  userA User @relation("ConnectionUserA", fields: [userAId], references: [id])

  userB User @relation("ConnectionUserB", fields: [userBId], references: [id])

  request ConnectionRequest @relation(fields: [requestId], references: [id])

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("connections")
}
